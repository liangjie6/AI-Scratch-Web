SUI_XIANG_API_KEY=replace-with-server-side-key
AGNES_API_KEY=replace-with-server-side-key
DEEPSEEK_API_KEY=replace-with-server-side-key
GPT_API_KEY=replace-with-server-side-key
IMAGE_REQUEST_TIMEOUT_SECONDS=90
IMAGE_MAX_DOWNLOAD_BYTES=12582912
IMAGE_MAX_REQUEST_BYTES=16384
IMAGE_MAX_CONCURRENCY=2
AI_BLOCKS_MAX_REQUEST_BYTES=262144
AI_BLOCKS_MAX_CONCURRENCY=2
AI_BLOCKS_PROVIDER_TIMEOUT_SECONDS=480
# Controls app.* business-flow logs. HTTP transport loggers remain WARNING.
AI_SCRATCH_LOG_LEVEL=INFO
AI_BLOCKS_MAX_REPAIR_ROUNDS=3
# Versioned source-derived IntentSpec/compact script pipeline; old requests remain supported.
AI_BLOCKS_SOURCE_PIPELINE_ENABLED=true
# Local diagnostics only: start-all.bat enables this automatically and logs a
# bounded model-output excerpt on protocol failures. Keep false in deployments.
AI_BLOCKS_VERBOSE_LOGGING=false
# Emergency browser-side project-write kill switch. Chat and draft generation remain available.
AI_BLOCKS_COMMIT_ENABLED=true
AI_PROJECT_ASSETS_ENABLED=true
AI_SOUND_ASSETS_ENABLED=true
AI_LOGICAL_RESOURCE_REFS_ENABLED=true
AI_SHORT_COMMIT_ENABLED=true
AI_AUDIO_GENERATION_ENABLED=false
AI_ASSET_AUTO_MATCH_ENABLED=false
AI_ASSET_AUTO_MATCH_MIN_SCORE=8
AI_ASSET_AUTO_MATCH_MIN_MARGIN=5
AI_RUNS_DATABASE_PATH=data/ai-runs.sqlite3
AI_RUNS_EVENT_RETENTION_HOURS=24
AI_RUNS_RETENTION_DAYS=7
AI_DURABLE_RUNS_ENABLED=false
# Keep at 0 during internal verification, then increase 5 -> 25 -> 100.
AI_DURABLE_RUNS_ROLLOUT_PERCENT=100
AI_CRASH_CHECKPOINT_ENABLED=true
# Requires the paired frontend VITE_AI_PEN_EXTENSION_ENABLED=true build.
AI_PEN_EXTENSION_ENABLED=false
# Requires the paired frontend VITE_AI_MUSIC_EXTENSION_ENABLED=true build.
AI_MUSIC_EXTENSION_ENABLED=false
# Requires the paired frontend VITE_AI_TEXT_TO_SPEECH_EXTENSION_ENABLED=true build.
AI_TEXT_TO_SPEECH_EXTENSION_ENABLED=false
# Keep disabled until per-operation approval and compensation are released.
AI_DESTRUCTIVE_RESOURCE_OPS_ENABLED=false

# 私人工具入口：填入至少 16 字节随机口令后才能启动；不要提交真实口令。
AI_SCRATCH_ACCESS_USER=owner
# AI_SCRATCH_ACCESS_PASSWORD=
