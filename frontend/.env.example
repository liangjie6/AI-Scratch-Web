# Enable only after the paired backend exposes /api/ai-runs.
VITE_AI_DURABLE_RUNS_ENABLED=false
# AI Commit requires the pinned Scratch 15.1.x capability probe to remain valid.
VITE_SCRATCH_EDITOR_15_1_ENABLED=true
# Requires AI_PEN_EXTENSION_ENABLED=true on the paired backend.
VITE_AI_PEN_EXTENSION_ENABLED=false
# Requires AI_MUSIC_EXTENSION_ENABLED=true on the paired backend.
VITE_AI_MUSIC_EXTENSION_ENABLED=false
# Text submitted to this extension is sent to Scratch's synthesis service only after per-request consent.
VITE_AI_TEXT_TO_SPEECH_EXTENSION_ENABLED=false
# Keep review-only until the fixed calibration corpus proves the match threshold.
VITE_AI_ASSET_AUTO_MATCH_ENABLED=false
# Thresholds may be raised after calibration, never lowered below the safe defaults.
VITE_AI_ASSET_AUTO_MATCH_MIN_SCORE=8
VITE_AI_ASSET_AUTO_MATCH_MIN_MARGIN=5
# Project-wide resource planning requires the paired asset contract and Scratch probe.
VITE_AI_PROJECT_ASSETS_ENABLED=true
# Disable to keep generated projects on the legacy image-only resource path.
VITE_AI_SOUND_ASSETS_ENABLED=true
# Reserved for a future audio provider; keep disabled until backend capability is released.
VITE_AI_AUDIO_GENERATION_ENABLED=false
# Logical menu references and the short, precompiled Commit path are safety gates.
VITE_AI_LOGICAL_RESOURCE_REFS_ENABLED=true
VITE_AI_SHORT_COMMIT_ENABLED=true
# Paired with AI_BLOCKS_COMMIT_ENABLED. Set false to disable new browser project writes.
VITE_AI_BLOCKS_COMMIT_ENABLED=true
# Commit is fail-closed unless browser checkpoint protection is available.
VITE_AI_CRASH_CHECKPOINT_ENABLED=true
