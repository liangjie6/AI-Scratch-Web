# AI Scratch Web — user-level nginx reverse proxy.
#
# Rendered by deploy/scripts/start-nginx.sh from nginx.conf.template.
# It runs entirely inside the deployment prefix so it needs no root privileges:
# the master process, pid file, logs and temp paths all live under the prefix.
#
# Serves the built frontend from __WEB_ROOT__ and proxies /api/ and /health to
# the Go backend on __BACKEND__.

worker_processes  2;
pid               logs/nginx.pid;
error_log         logs/error.log warn;

events {
    worker_connections  1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    access_log    logs/access.log;

    client_body_temp_path temp/client_body;
    proxy_temp_path       temp/proxy;
    fastcgi_temp_path     temp/fastcgi;
    uwsgi_temp_path       temp/uwsgi;
    scgi_temp_path        temp/scgi;

    sendfile           on;
    tcp_nopush         on;
    keepalive_timeout  65;
    server_tokens      off;

    gzip              on;
    gzip_vary         on;
    gzip_min_length   1024;
    gzip_proxied      any;
    gzip_types        text/plain text/css text/xml application/json
                      application/javascript application/xml
                      application/xml+rss image/svg+xml;

    upstream ai_scratch_backend {
        server __BACKEND__;
        keepalive 16;
    }

    # Shared proxy settings for the API surface. Buffering stays disabled so
    # server-sent event streams reach the browser frame by frame.
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    server {
        # Dual-stack listener: IPv4 on every interface and IPv6 (including the
        # host's global address) on the same port. HTTPS is enabled with
        # AI_SCRATCH_TLS=1.
        listen      __LISTEN_IPV4__:__PORT__ __TLS_LISTEN_SUFFIX__default_server;
        listen      __LISTEN_IPV6__:__PORT__ __TLS_LISTEN_SUFFIX__default_server;
        server_name _;
        auth_basic "AI Scratch private";
        auth_basic_user_file __AUTH_FILE__;

        client_max_body_size 8m;

        __TLS_DIRECTIVES__

        root  __WEB_ROOT__;
        index index.html;

        # The standalone Scratch bundle was built with webpack's public path set
        # to "/", so it requests lazy chunks from /chunks/*. Translate only that
        # exact prefix onto the bundled asset directory.
        location /chunks/ {
            rewrite ^/chunks/(.*)$ /assets/scratch/chunks/$1 last;
        }

        location /static/assets/ {
            rewrite ^/static/assets/(.*)$ /assets/scratch/static/assets/$1 last;
        }

        location /api/ {
            proxy_pass         http://ai_scratch_backend;
            proxy_http_version 1.1;
            proxy_set_header   Host              $http_host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
            proxy_set_header   Connection        "";
            proxy_set_header   Upgrade           $http_upgrade;

            # Server-sent events must not be buffered.
            proxy_buffering    off;
            proxy_cache        off;
            proxy_read_timeout 900s;
            proxy_send_timeout 900s;
            chunked_transfer_encoding on;
        }

    location = /healthz {
        auth_basic off;
        proxy_pass http://ai_scratch_backend;
        proxy_set_header Host $http_host;
    }

        location = /health {
            proxy_pass         http://ai_scratch_backend;
            proxy_http_version 1.1;
            proxy_set_header   Host $http_host;
            proxy_buffering    off;
        }

        # Immutable hashed bundles and the prebuilt Scratch runtime.
        location /assets/ {
            expires    30d;
            add_header Cache-Control "public, immutable";
            try_files  $uri =404;
        }

        location = /index.html {
            add_header Cache-Control "no-cache";
        }

        location / {
            try_files $uri $uri/ /index.html;
        }
    }
}
